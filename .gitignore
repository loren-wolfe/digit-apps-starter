node_modules/
dist/
.DS_Store
*.log
.vite/
*.zip

# Digit app build outputs (pack into app.zip only — not committed)
# Sibling to package.json; do not match src/frontend or src/backend.
apps/*/frontend/
apps/*/backend/
examples/*/frontend/
examples/*/backend/
templates/*/frontend/
templates/*/backend/

# Local secrets. Only the *.example placeholders are committed.
.env
.env.*
!.env.example
!.env.local.example
.claude/*

# Temp app copies from packages/cli/test (removed after each run)
packages/cli/test/.tmp-*/
